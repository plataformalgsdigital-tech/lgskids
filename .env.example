# ============================================================
# KIDS2026 — Variables de entorno
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` ni secretos reales al repositorio.
# Secretos por ambiente: GitHub Environments y DigitalOcean.
# ============================================================

# Entorno: development | test | production
NODE_ENV=development

# URL pública de la aplicación
# Producción: https://lgskidsplataforma.com
APP_URL=http://localhost:3000

# --- Base de datos -------------------------------------------
# Conexión CON POOL para la aplicación.
# Local (docker compose -f infra/docker/docker-compose.yml up -d):
DATABASE_URL=postgresql://kids:kids_dev@localhost:5432/kids2026

# Conexión DIRECTA (sin pool) — solo para migraciones.
DIRECT_DATABASE_URL=postgresql://kids:kids_dev@localhost:5432/kids2026

# Máximo de conexiones del pool. La base administrada de DigitalOcean
# admite ~22 conexiones en total: mantener entre 8 y 10.
DB_POOL_MAX=8

# --- Observabilidad ------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- Operación -----------------------------------------------
# Zona operativa por defecto para salones nuevos (cada salón puede
# configurar la suya): America/Santiago | America/Bogota |
# America/Guayaquil | America/Lima
OPERATIONAL_TIMEZONE_DEFAULT=America/Santiago
