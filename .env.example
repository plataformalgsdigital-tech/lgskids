# ============================================================
# KIDS2026 — Variables de entorno
# Copia este archivo a `.env` y completa los valores.
# NUNCA subas `.env` ni secretos reales al repositorio.
# Secretos por ambiente: GitHub Environments y DigitalOcean.
# ============================================================

# Entorno: development | test | production
NODE_ENV=development

# URL pública de la aplicación
# Producción: https://lgskidsplataforma.com
APP_URL=http://localhost:3000

# --- Base de datos -------------------------------------------
# Conexión CON POOL para la aplicación.
# Local (docker compose -f infra/docker/docker-compose.yml up -d):
DATABASE_URL=postgresql://kids:kids_dev@localhost:5432/kids2026

# Conexión DIRECTA (sin pool) — solo para migraciones.
DIRECT_DATABASE_URL=postgresql://kids:kids_dev@localhost:5432/kids2026

# Certificado (PEM, en una línea con \n) de la CA de la base administrada.
# En producción es OBLIGATORIO: DigitalOcean firma su base con su propia
# autoridad y `pg` verifica de verdad desde 8.22. Sin él: "self-signed
# certificate in certificate chain". Se obtiene en el panel de la base o por
# la API (/v2/databases/<id>/ca). Vacío en local (Postgres sin TLS).
# OJO: en la URL de la app NO pongas `sslmode`; con el certificado presente
# el pool lo quita, porque `pg` le da prioridad y rompería la verificación.
# El de MIGRACIONES (Prisma) sí lleva `?sslmode=require`.
DATABASE_CA_CERT=

# Máximo de conexiones del pool. La base administrada de DigitalOcean
# admite ~22 conexiones en total: mantener entre 8 y 10.
DB_POOL_MAX=8

# --- Autenticación -------------------------------------------
# Secreto de firma de JWT. Mínimo 32 caracteres, aleatorio.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=

# Vida del access token (segundos) y del refresh token (días)
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_DAYS=30

# Bóveda de claves: copia CIFRADA de cada contraseña para que el superadmin
# pueda consultarla. 32 bytes en base64, DISTINTA de AUTH_JWT_SECRET.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Vacía = no se guarda ninguna copia y "Ver clave" queda apagado.
# Perderla = las copias guardadas dejan de poder leerse (las claves siguen
# funcionando para entrar: el acceso usa el hash, no la copia).
PASSWORD_VAULT_KEY=

# --- Seed (solo desarrollo / primer despliegue) --------------
# Credenciales del admin inicial que crea `pnpm seed`.
# El admin queda obligado a cambiar la contraseña al primer ingreso.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# --- WhatsApp Cloud API (Fase 11) ----------------------------
# Sin credenciales, las notificaciones van al log (LogSender).
# Con ambas, se envían de verdad vía Meta WhatsApp Cloud API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- Archivos ------------------------------------------------
# Carpeta del adaptador local (desarrollo y CI).
STORAGE_DIR=.storage

# En PRODUCCIÓN mandan estas cuatro: con ellas `getStorage()` usa
# DigitalOcean Spaces en vez del disco, que en App Platform es
# EFÍMERO (lo subido desaparece en el siguiente despliegue). Van las
# cuatro o ninguna: a medias, la app no arranca.
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=
# Opcional; por defecto https://<region>.digitaloceanspaces.com
SPACES_ENDPOINT=

# --- Observabilidad ------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- Operación -----------------------------------------------
# Zona operativa por defecto para salones nuevos (cada salón puede
# configurar la suya): America/Santiago | America/Bogota |
# America/Guayaquil | America/Lima
OPERATIONAL_TIMEZONE_DEFAULT=America/Santiago

# --- Integración LGS (Fase B) --------------------------------
# Clave de servicio para el intake de beneficiarios desde LGS
# (header x-api-key). Mínimo 16 caracteres. Si se deja vacía, la
# puerta /api/kids-intake/* queda CERRADA (todo 401).
LGS_INTAKE_API_KEY=
