{
  "name": "kids2026",
  "version": "0.1.0",
  "private": true,
  "description": "KIDS2026 — Plataforma de gestión académica de LGS Kids (lgskidsplataforma.com)",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs",
    "seed": "tsx scripts/seed.ts",
    "demo:alumno": "tsx scripts/demo-alumno.ts",
    "worker:dev": "tsx worker/index.ts",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:arch && pnpm format:check && pnpm build && pnpm audit --prod --audit-level high",
    "demo:sesion": "tsx scripts/demo-sesion.ts",
    "imagenes:optimizar": "tsx scripts/optimizar-imagenes.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "jose": "^6.2.12",
    "next": "^16.3.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/client": "^7.10.0",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
