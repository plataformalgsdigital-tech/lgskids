{
  "name": "kids2026",
  "version": "0.1.0",
  "private": true,
  "description": "KIDS2026 — Plataforma de gestión académica de LGS Kids (lgskidsplataforma.com)",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:arch": "depcruise src --config .dependency-cruiser.cjs",
    "seed": "tsx scripts/seed.ts",
    "demo:alumno": "tsx scripts/demo-alumno.ts",
    "worker:dev": "tsx worker/index.ts",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:arch && pnpm build",
    "demo:sesion": "tsx scripts/demo-sesion.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^7.9.0",
    "jose": "^6.2.4",
    "next": "^16.2.11",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "prettier": "^3.9.6",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
