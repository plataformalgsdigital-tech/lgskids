// Esquema KIDS2026 — Fase 3: identity, access, audit.
// Convenciones (ADR-0004): esquema único, tablas con prefijo de módulo,
// UUID expuestos, created_at/updated_at, snake_case en base.
// Instantes SIEMPRE en timestamptz (ADR-0007).
// Migraciones versionadas; NUNCA `prisma db push` contra producción.

datasource db {
  provider = "postgresql"
}

// ============================================================
// access — países, roles, permisos
// ============================================================

model Country {
  code      String   @id @db.Char(2) // CL | CO | EC | PE
  nombre    String
  timezone  String // zona operativa (ADR-0007)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userRoles UserRole[]

  @@map("access_country")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // admin | coordinador | guia | apoderado | alumno
  nombre      String
  descripcion String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("access_role")
}

model Permission {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique // ej. usuarios.gestionar, auditoria.ver
  nombre    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("access_permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("access_role_permission")
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  // NULL = alcance global; con valor = rol limitado a ese país (ADR-0009).
  countryCode String?  @map("country_code") @db.Char(2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  country Country? @relation(fields: [countryCode], references: [code])

  // Nota: countryCode NULL no participa del unique en Postgres; el caso
  // "mismo rol global duplicado" se controla en el caso de uso.
  @@unique([userId, roleId, countryCode])
  @@index([userId])
  @@map("access_user_role")
}

// ============================================================
// identity — usuarios, sesiones, intentos
// ============================================================

enum UserEstado {
  ACTIVO
  INACTIVO
  BLOQUEADO

  @@map("identity_user_estado")
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  username String @unique // el LOGIN es por username, no por correo (ADR-0005)
  // Sin UNIQUE: hermanos comparten el correo del apoderado. Puede ser
  // sintético (@alumnos.lgskidsplataforma.com, no enrutable).
  email               String?
  emailSintetico      Boolean    @default(false) @map("email_sintetico")
  passwordHash        String     @map("password_hash") // argon2id
  estado              UserEstado @default(ACTIVO)
  debeCambiarPassword Boolean    @default(false) @map("debe_cambiar_password")
  ultimoLoginEn       DateTime?  @map("ultimo_login_en") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  roles         UserRole[]
  person        Person?

  @@map("identity_user")
}

model RefreshToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  // Solo se guarda el hash del token (sha256); el valor viaja en la cookie.
  tokenHash String @unique @map("token_hash")
  // Familia de rotación: reuso de un token ya rotado = posible robo →
  // se revoca la familia completa.
  familyId      String    @map("family_id") @db.Uuid
  expiraEn      DateTime  @map("expira_en") @db.Timestamptz(3)
  revocadoEn    DateTime? @map("revocado_en") @db.Timestamptz(3)
  motivoRevoque String?   @map("motivo_revoque")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiraEn]) // purga del worker
  @@map("identity_refresh_token")
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement())
  username  String
  ip        String
  exito     Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // Rate limiting persistido en tabla (nada en memoria — trampa 2.8.5).
  @@index([username, createdAt])
  @@index([ip, createdAt])
  @@map("identity_login_attempt")
}

// ============================================================
// catalog — campaña, curso, nivel, lección, cuestionario
// ============================================================

enum CourseTipo {
  JUNIOR // 6–9 años
  YOUNGSTER // 10–13 años

  @@map("catalog_course_tipo")
}

enum QuizTipo {
  PRACTICA // uno por lección
  LEVEL_UP // uno por nivel; aprobarlo promueve

  @@map("catalog_quiz_tipo")
}

model Campaign {
  id     String @id @default(uuid()) @db.Uuid
  nombre String @unique
  // Campaña GLOBAL (ADR-0009): el país vive en el contrato, no aquí.
  // El estado (En matrícula | Activa | Cerrada) se DERIVA por fecha,
  // nunca se almacena.
  inicio DateTime @db.Date
  fin    DateTime @db.Date // inicio + 12 meses (editable)
  // Cierre de matrícula: inicio del curso + 3 semanas. Umbral EN_MATRÍCULA→ACTIVA.
  finalVenta DateTime @map("final_venta") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  courses Course[]

  @@index([inicio, fin])
  @@map("catalog_campaign")
}

model Course {
  id         String     @id @default(uuid()) @db.Uuid
  campaignId String     @map("campaign_id") @db.Uuid
  tipo       CourseTipo
  inicio     DateTime   @db.Date
  // REGLA DURA 1: final_curso NUNCA se reescribe. Es la ventana nominal
  // con la que se cuenta el número de sesiones; el fin real del curso es
  // la fecha de su última sesión (scheduling). No existe endpoint que lo
  // edite.
  finalCurso DateTime @map("final_curso") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  levels   Level[]
  awards   Award[]

  // Una campaña genera UN curso por tipo.
  @@unique([campaignId, tipo])
  @@map("catalog_course")
}

model Level {
  id          String @id @default(uuid()) @db.Uuid
  courseId    String @map("course_id") @db.Uuid
  codigo      String // ROOKIE | CHAMPION | ELITE | LEGENDARY | ULTIMATE
  orden       Int // 1..5
  nombre      String
  duracionMeses Int @default(2) @map("duracion_meses") // Rookie/Champion/Ultimate 2, Elite/Legendary 3
  descripcion String? // referencia del nivel
  recursos    Json? // [{nombre,link}] a nivel de nivel

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  quizzes Quiz[]
  progress LevelProgress[]
  awards   Award[]

  @@unique([courseId, orden])
  @@unique([courseId, codigo])
  @@map("catalog_level")
}

model Lesson {
  id      String @id @default(uuid()) @db.Uuid
  levelId String @map("level_id") @db.Uuid
  orden   Int // 1..4 (4 lecciones por nivel)
  titulo  String
  // El material vive en catalog_curso (tabla maestra de referencia), no aquí.

  level Level @relation(fields: [levelId], references: [id], onDelete: Cascade)
  quizzes Quiz[]

  @@unique([levelId, orden])
  @@map("catalog_lesson")
}

/// Referencia MAESTRA de cursos (independiente de campañas): material, video,
/// actividades y recursos por (curso, nivel, modulo, leccion). Fuente para los
/// paneles de alumno/guía y las actividades de seguimiento.
model CursoReferencia {
  id              String     @id @default(uuid()) @db.Uuid
  curso           CourseTipo // JUNIOR | YOUNGSTER
  nivel           String // ROOKIE | CHAMPION | ELITE | LEGENDARY | ULTIMATE
  modulo          String?
  leccion         String
  orden           Int        @default(0)
  contenido       String? // temario (markdown)
  video           String? // key de storage o URL
  clubes          Json?
  materialUsuario Json?      @map("material_usuario")
  materialGuia    Json?      @map("material_guia")
  actividades     Json?
  recursos        Json?
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([curso, nivel, orden])
  @@map("catalog_curso")
}

model Quiz {
  id      String   @id @default(uuid()) @db.Uuid
  levelId String   @map("level_id") @db.Uuid
  // PRACTICA → lessonId obligatorio; LEVEL_UP → lessonId NULL.
  // (La exclusividad la garantiza la generación transaccional única.)
  lessonId String?  @map("lesson_id") @db.Uuid
  tipo     QuizTipo
  titulo   String
  // Preguntas del cuestionario (referencia): [{enunciado,opciones[],correcta,explicacion?}].
  contenido Json?
  modo     String @default("MANUAL") // IA | MANUAL
  minutos  Int? // tiempo del alumno para el examen

  level  Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@unique([lessonId, tipo])
  @@index([levelId])
  @@map("catalog_quiz")
}

// ============================================================
// people — niño, apoderado, titular
// ============================================================

enum PersonEstado {
  ACTIVA
  INACTIVA

  @@map("people_person_estado")
}

model Person {
  id        String  @id @default(uuid()) @db.Uuid
  nombres   String
  apellidos String
  // Obligatoria para niños (valida edad vs tipo de curso); opcional en adultos.
  fechaNacimiento DateTime? @map("fecha_nacimiento") @db.Date
  docTipo         String    @map("doc_tipo") // CC | TI | RUT | DNI | PASAPORTE...
  docNumero       String    @map("doc_numero")
  countryCode     String    @map("country_code") @db.Char(2)
  email           String?
  telefono        String? // WhatsApp del apoderado para notificaciones
  estado          PersonEstado @default(ACTIVA)
  // Credenciales del niño (se crean al aprobar su contrato — alta única).
  userId    String?  @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User?          @relation(fields: [userId], references: [id])
  comoNino         Guardianship[] @relation("nino")
  enrollments      Enrollment[]
  attendances      Attendance[]
  quizAttempts     QuizAttempt[]
  levelProgress    LevelProgress[]
  awards           Award[]
  comoApoderado    Guardianship[] @relation("apoderado")
  contratosTitular Contract[]     @relation("titular")
  contratosBenef   Contract[]     @relation("beneficiario")

  // Documento único por persona (restricción del negocio).
  @@unique([countryCode, docTipo, docNumero])
  @@index([apellidos, nombres])
  @@map("people_person")
}

model Guardianship {
  id          String  @id @default(uuid()) @db.Uuid
  ninoId      String  @map("nino_id") @db.Uuid
  apoderadoId String  @map("apoderado_id") @db.Uuid
  parentesco  String? // madre | padre | tutor...

  nino      Person @relation("nino", fields: [ninoId], references: [id], onDelete: Cascade)
  apoderado Person @relation("apoderado", fields: [apoderadoId], references: [id], onDelete: Cascade)

  @@unique([ninoId, apoderadoId])
  @@index([apoderadoId])
  @@map("people_guardianship")
}

// ============================================================
// contracts — el contrato NACE EN KIDS (ADR-0008)
// ============================================================

enum ContractEstado {
  PENDIENTE
  APROBADO
  ONHOLD
  INACTIVO

  @@map("contracts_estado")
}

model Contract {
  id String @id @default(uuid()) @db.Uuid
  // Correlativo humano para búsqueda y comunicación ("contrato N° 1042").
  numero         Int     @unique @default(autoincrement())
  titularId      String  @map("titular_id") @db.Uuid
  beneficiarioId String  @map("beneficiario_id") @db.Uuid
  countryCode    String  @map("country_code") @db.Char(2) // AQUÍ vive el país (ADR-0009)
  tipoCurso      CourseTipo @map("tipo_curso")
  inicio         DateTime   @db.Date
  // DATE puro (sin hora ni zona). Vencido SOLO cuando la fecha UTC del
  // servidor es >= 2 días posterior — UNA función lo decide (domain/vigencia).
  // OnHold extiende esta fecha al reactivar (días pausados, auditado).
  finalContrato DateTime       @map("final_contrato") @db.Date
  estado        ContractEstado @default(PENDIENTE)
  // Entrada desde LGS (ADR-0010): N° de contrato en LGS (idempotencia) y
  // "firmado sin aprobar". NULL cuando el contrato nace en KIDS (ADR-0008).
  externalRef String?  @unique @map("external_ref")
  firmado     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  titular      Person         @relation("titular", fields: [titularId], references: [id])
  beneficiario Person         @relation("beneficiario", fields: [beneficiarioId], references: [id])
  onholds      ContractHold[]
  enrollments  Enrollment[]

  @@index([beneficiarioId, estado])
  @@index([estado, finalContrato]) // barrido diario de vencimiento
  @@map("contracts_contract")
}

// ============================================================
// enrollment — matrícula, cupos, cambio académico
// ============================================================

enum EnrollmentEstado {
  ACTIVA
  FINALIZADA // terminó o fue movida por cambio académico (historial)
  CANCELADA
  RESERVADA // retiene cupo; el alumno se ACTIVA al aprobar el contrato (entrada LGS)

  @@map("enrollment_estado")
}

model Enrollment {
  id            String @id @default(uuid()) @db.Uuid
  contractId    String @map("contract_id") @db.Uuid
  childPersonId String @map("child_person_id") @db.Uuid
  classroomId   String @map("classroom_id") @db.Uuid
  estado        EnrollmentEstado @default(ACTIVA)
  // Motivo del cierre (cambio académico, cancelación) — obligatorio al cerrar.
  motivoCierre String?  @map("motivo_cierre")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  contract  Contract  @relation(fields: [contractId], references: [id])
  child     Person    @relation(fields: [childPersonId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  // La LISTA de una sesión se DERIVA de las matrículas ACTIVAS del salón
  // (regla de oro del modelo de cohortes) — no hay tabla de inscripciones
  // que pueda desincronizarse; regenerar sesiones no toca la matrícula.
  @@index([classroomId, estado])
  @@index([childPersonId, estado])
  @@index([contractId, estado])
  @@map("enrollment_enrollment")
}

model ContractHold {
  id         String    @id @default(uuid()) @db.Uuid
  contractId String    @map("contract_id") @db.Uuid
  desde      DateTime  @db.Date
  hasta      DateTime? @db.Date // NULL = pausa vigente
  // Días que se sumaron a final_contrato al reactivar (historial).
  diasExtendidos Int?     @map("dias_extendidos")
  motivo         String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contracts_onhold")
}

// ============================================================
// scheduling — salón, sesiones, feriados, suspensiones
// ============================================================

enum SlotTipo {
  SESION // 2 por semana, cuentan para la progresión
  CLUB // viernes o sábado, práctica con inscripción

  @@map("scheduling_slot_tipo")
}

model Classroom {
  id       String  @id @default(uuid()) @db.Uuid
  courseId String  @map("course_id") @db.Uuid
  nombre   String
  // Guía asignado (usuario con rol guia). Opcional hasta tener gestión de guías.
  guiaUserId String? @map("guia_user_id") @db.Uuid
  cupo       Int
  meetingUrl String? @map("meeting_url") // clases virtuales (decisión 2026-07-22)
  // Zona operativa DEL SALÓN (ADR-0007): el horario "martes 18:00" se
  // interpreta aquí. Configurable por salón.
  timezone String
  // Calendario de feriados DEL SALÓN (ADR-0009): SOLO este país suspende
  // y corre sesiones; feriados del país del niño = ausencia justificable.
  holidayCountry String   @map("holiday_country") @db.Char(2)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  slots       Slot[]
  sessions    Session[]
  suspensions Suspension[]
  enrollments Enrollment[]

  @@index([courseId])
  @@map("scheduling_classroom")
}

model Slot {
  id          String   @id @default(uuid()) @db.Uuid
  classroomId String   @map("classroom_id") @db.Uuid
  tipo        SlotTipo
  // 0=domingo … 6=sábado, en la zona operativa del salón.
  diaSemana Int    @map("dia_semana")
  horaLocal String @map("hora_local") // "HH:MM" en la zona del salón
  duracionMin Int  @default(60) @map("duracion_min")

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  sessions  Session[]

  @@unique([classroomId, diaSemana, horaLocal])
  @@map("scheduling_slot")
}

// Catálogo de horarios reutilizables POR TIPO DE CURSO (mantenimiento
// centralizado, inspirado en HORARIOS_CURSO de Mosaico pero ESTRUCTURADO —
// sin el string frágil). Se ELIGE al crear un salón y se materializa en sus
// Slot; NO participa en la generación de sesiones (solo alimenta el selector).
model HorarioCatalogo {
  id          String     @id @default(uuid()) @db.Uuid
  tipoCurso   CourseTipo @map("tipo_curso")
  grupoPais   String     @default("01") @map("grupo_pais") // 01=Chile; 02=Colombia, Ecuador y Perú
  salonNumero String     @default("01") @map("salon_numero") // salón del horario completo (todos sus días)
  etiqueta    String // nombre legible, ej. "Lun-Mié 16:00"
  activo      Boolean    @default(true) // desactivar en vez de borrar
  orden       Int        @default(0)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  slots HorarioCatalogoSlot[]

  @@unique([tipoCurso, grupoPais, salonNumero, etiqueta])
  @@index([tipoCurso, activo])
  @@map("scheduling_horario")
}

model HorarioCatalogoSlot {
  id          String   @id @default(uuid()) @db.Uuid
  horarioId   String   @map("horario_id") @db.Uuid
  tipo        SlotTipo
  diaSemana   Int      @map("dia_semana") // 0=domingo … 6=sábado
  horaLocal   String   @map("hora_local") // "HH:MM"
  duracionMin Int      @default(60) @map("duracion_min")

  horario HorarioCatalogo @relation(fields: [horarioId], references: [id], onDelete: Cascade)

  @@unique([horarioId, diaSemana, horaLocal])
  @@map("scheduling_horario_slot")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  classroomId String   @map("classroom_id") @db.Uuid
  slotId      String   @map("slot_id") @db.Uuid
  tipo        SlotTipo
  // Fecha OPERATIVA (día en la zona del salón) y el instante UTC exacto.
  fecha    DateTime @db.Date
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  duracionMin Int   @map("duracion_min")
  // Número correlativo dentro de su slot (1..N nominal). El fin REAL del
  // curso es la fecha de la última sesión — final_curso NUNCA se toca.
  numero    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  slot      Slot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@unique([classroomId, startsAt])
  @@unique([slotId, numero])
  @@index([classroomId, fecha]) // lista de sesión por salón y día
  @@map("scheduling_session")
}

model Holiday {
  countryCode String   @map("country_code") @db.Char(2)
  fecha       DateTime @db.Date
  nombre      String
  // 'codigo' = calculado (fijos + Semana Santa + traslados de ley);
  // 'json' = curado manual (decretos). El JSON SOLO SUMA, nunca anula.
  fuente    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([countryCode, fecha])
  @@map("scheduling_holiday")
}

model Suspension {
  id          String   @id @default(uuid()) @db.Uuid
  classroomId String   @map("classroom_id") @db.Uuid
  fecha       DateTime @db.Date
  motivo      String // OBLIGATORIO y auditado (sección 2.3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  // EN TABLA, nunca en memoria: la regeneración es destructiva y las relee.
  @@unique([classroomId, fecha])
  @@map("scheduling_suspension")
}

// ============================================================
// attendance — asistencia y justificaciones
// ============================================================

enum AttendanceEstado {
  PRESENTE
  AUSENTE
  JUSTIFICADO // incluye feriado del país del niño distinto al del salón

  @@map("attendance_estado")
}

model Attendance {
  id            String @id @default(uuid()) @db.Uuid
  sessionId     String @map("session_id") @db.Uuid
  childPersonId String @map("child_person_id") @db.Uuid
  estado        AttendanceEstado
  justificacion String?
  // Quién marcó (guía/coordinador) y cuándo — auditable en la propia fila.
  marcadoPor String   @map("marcado_por") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  child   Person  @relation(fields: [childPersonId], references: [id])

  // Una marca por niño y sesión; re-marcar ACTUALIZA (upsert).
  @@unique([sessionId, childPersonId])
  @@index([childPersonId, sessionId])
  @@map("attendance_attendance")
}

// ============================================================
// assessment — intentos de cuestionario y calificación
// ============================================================

model QuizAttempt {
  id            String @id @default(uuid()) @db.Uuid
  quizId        String @map("quiz_id") @db.Uuid
  childPersonId String @map("child_person_id") @db.Uuid
  score         Int // 0–100
  aprobado      Boolean
  registradoPor String   @map("registrado_por") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  quiz  Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  child Person @relation(fields: [childPersonId], references: [id])

  @@index([childPersonId, quizId])
  @@index([quizId])
  @@map("assessment_attempt")
}

// ============================================================
// progression — LA función central de avance (regla dura 4)
// ============================================================

enum ProgressEstado {
  EN_CURSO
  COMPLETADO

  @@map("progression_estado")
}

model LevelProgress {
  id            String @id @default(uuid()) @db.Uuid
  childPersonId String @map("child_person_id") @db.Uuid
  levelId       String @map("level_id") @db.Uuid
  // DERIVADO de assessment por la función central — nunca se edita a mano.
  leccionesCompletadas Int            @default(0) @map("lecciones_completadas")
  levelUpAprobado      Boolean        @default(false) @map("level_up_aprobado")
  estado               ProgressEstado @default(EN_CURSO)
  completadoEn         DateTime?      @map("completado_en") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  child Person @relation(fields: [childPersonId], references: [id], onDelete: Cascade)
  level Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([childPersonId, levelId])
  @@index([childPersonId])
  @@map("progression_level_progress")
}

enum AwardTipo {
  MEDALLA // al completar un nivel
  DIPLOMA // al completar los 4 niveles del curso

  @@map("progression_award_tipo")
}

model Award {
  id            String    @id @default(uuid()) @db.Uuid
  childPersonId String    @map("child_person_id") @db.Uuid
  tipo          AwardTipo
  levelId       String?   @map("level_id") @db.Uuid // MEDALLA
  courseId      String?   @map("course_id") @db.Uuid // DIPLOMA
  otorgadoEn    DateTime  @default(now()) @map("otorgado_en") @db.Timestamptz(3)
  // El envío por WhatsApp llega en Fase 10 (notifications).
  notificadoEn DateTime? @map("notificado_en") @db.Timestamptz(3)

  child  Person  @relation(fields: [childPersonId], references: [id], onDelete: Cascade)
  level  Level?  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Una medalla por nivel y un diploma por curso (NULL no colisiona; la
  // función central es el único camino que otorga).
  @@unique([childPersonId, tipo, levelId, courseId])
  @@index([childPersonId])
  @@map("progression_award")
}

// ============================================================
// notifications — outbox de WhatsApp/correo
// ============================================================

enum NotifCanal {
  WHATSAPP
  EMAIL

  @@map("notifications_canal")
}

enum NotifEstado {
  PENDIENTE
  ENVIADA
  FALLIDA

  @@map("notifications_estado")
}

model NotificationOutbox {
  id           String     @id @default(uuid()) @db.Uuid
  canal        NotifCanal
  destinatario String // teléfono E.164 o correo REAL (del apoderado)
  mensaje      String
  // Contexto para plantillas/reintentos (tipo de aviso, ids).
  payload     Json?
  estado      NotifEstado @default(PENDIENTE)
  intentos    Int         @default(0)
  ultimoError String?     @map("ultimo_error")
  enviadaEn   DateTime?   @map("enviada_en") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  // OUTBOX: nada se envía en línea con la operación de negocio; el worker
  // despacha con reintentos. Nada de estado en memoria (trampa 2.8.5).
  @@index([estado, createdAt])
  @@map("notifications_outbox")
}

// ============================================================
// files — metadatos; los bytes viven en el StoragePort (ADR-0006)
// ============================================================

model FileObject {
  id             String @id @default(uuid()) @db.Uuid
  nombreOriginal String @map("nombre_original")
  mime           String
  sizeBytes      Int    @map("size_bytes")
  // Nombre interno NO predecible dentro del almacenamiento.
  storageKey String  @unique @map("storage_key")
  // PRIVADO POR DEFECTO — datos de menores (ADR-0006). No existe flag
  // "público": compartir es SIEMPRE vía descarga autenticada.
  subidoPor String   @map("subido_por") @db.Uuid
  entidad   String? // ej. people_person, contracts_contract
  entidadId String?  @map("entidad_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entidad, entidadId])
  @@map("files_object")
}

// ============================================================
// audit — separada de las tablas operativas
// ============================================================

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  accion        String // ej. auth.login, access.rol_asignado
  entidad       String // ej. identity_user
  entidadId     String?  @map("entidad_id")
  payload       Json?
  correlationId String?  @map("correlation_id")
  ip            String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entidad, entidadId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([accion, createdAt])
  @@map("audit_log")
}
